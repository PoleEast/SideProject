// 本檔僅為範本。
//
// 用途：列出「不可進版控」的機密設定。
//
// 少填任何一項，服務會在啟動時失敗並指名缺少哪個 key。
{
  // SQL Server 連線字串
  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  // JWT 簽章金鑰。HS256 要求至少 32 個字元
  "Jwt": {
    "Key": ""
  },

  // FinMind API token。
  "FinMindApi": {
    "Key": ""
  },

  // ExchangeRate-API 金鑰。
  "ExchangeRateApi": {
    "Key": ""
  }
}
