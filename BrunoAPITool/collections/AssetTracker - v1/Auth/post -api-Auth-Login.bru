meta {
  name: post /api/Auth/Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/Auth/Login
  body: json
  auth: inherit
}

body:json {
  {
    "account": "{{account}}",
    "password": "{{password}}"
  }
}

vars:pre-request {
  baseUrl: https://localhost:7118
}

script:post-response {
  if (res.status === 200 && res.body.token !== null) {
    bru.setVar("jwtToken", res.body.token);
  }
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/api/Auth/Login
    method: POST
    mode: json
    body:json: {
      {
        "account": "",
        "password": ""
      }
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
