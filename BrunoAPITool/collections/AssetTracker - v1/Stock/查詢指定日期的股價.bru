meta {
  name: 查詢指定日期的股價
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/Stock?stockMarketType=TW&code=2330&date=2026-01-01
  body: none
  auth: inherit
}

params:query {
  stockMarketType: TW
  code: 2330
  date: 2026-01-01
}

vars:pre-request {
  baseUrl: https://localhost:7118
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/api/Stock
    method: GET
    mode: none
    params:query: {
      ~stockMarketType: 
      ~code: 
      ~date: 
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "id": "",
          "stockMarket": "",
          "exchange": "",
          "code": "",
          "name": "",
          "openingPrice": "",
          "closingPrice": "",
          "high": "",
          "low": "",
          "volume": "",
          "currency": "",
          "date": "",
          "createdAt": "",
          "updatedAt": "",
          "deletedAt": ""
        }
      '''
    }
  }
}

