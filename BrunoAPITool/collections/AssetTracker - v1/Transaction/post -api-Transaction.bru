meta {
  name: post /api/Transaction
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/Transaction
  body: json
  auth: inherit
}

body:json {
  {
    "stockCode": "2330",
    "market": "TW",
    "date": "2025-01-01",
    "type": "Sell",
    "price": "1000",
    "quantity": "5000",
    "currency": "TWD",
    "remark": ""
  }
}

vars:pre-request {
  baseUrl: https://localhost:7118
}

assert {
  res.body.id: isNumber
  res.body.stockCode: eq "2330"
  res.body.market: eq "TW"
  res.body.date: eq "2025-01-01T00:00:00"
  res.body.type: eq "Buy"
  res.body.price: eq 500
  res.body.quantity: eq 1000
  res.body.currency: eq "TWD"
  res.body.remark: isString
  res.body.createdAt: isString
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/api/Transaction
    method: POST
    mode: json
    body:json: {
      {
        "stockCode": "",
        "market": "",
        "date": "",
        "type": "",
        "price": "",
        "quantity": "",
        "currency": "",
        "remark": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "id": "",
          "stockCode": "",
          "market": "",
          "date": "",
          "type": "",
          "price": "",
          "quantity": "",
          "currency": "",
          "remark": "",
          "createdAt": ""
        }
      '''
    }
  }
}

